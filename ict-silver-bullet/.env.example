# Supabase
# Database project URL for both processes.
SUPABASE_URL=https://your-project.supabase.co
# Private server-side service key for both processes.
SUPABASE_SERVICE_KEY=replace-with-service-key

# LLM API
# Brain review provider.
LLM_PROVIDER=replace-with-provider
# API key for the selected provider.
LLM_API_KEY=replace-with-api-key
# Model identifier for the selected provider.
LLM_MODEL=replace-with-model

# Firecrawl
# Brain web research API key.
FIRECRAWL_API_KEY=replace-with-api-key

# News APIs
# Optional FRED key; blank disables this client.
FRED_API_KEY=
# Optional Finnhub key; blank disables this client.
FINNHUB_API_KEY=
# Optional Marketaux key; blank disables this client.
MARKETAUX_API_KEY=
# Optional Alpha Vantage key; blank disables this client.
ALPHAVANTAGE_API_KEY=
# Optional NewsData key; blank disables this client.
NEWSDATA_API_KEY=

# Sentiment model
# Public sentiment model identifier; defaults to ProsusAI/finbert on CPU.
SENTIMENT_MODEL=ProsusAI/finbert

# Trading
# Comma-separated traded pairs; defaults to EURUSD,GBPUSD.
TRADED_PAIRS=EURUSD,GBPUSD
# Executor fallback broker UTC offset in hours; defaults to 0.
BROKER_UTC_OFFSET_HOURS=0

# Dashboard (brain side)
# Dashboard bind address; defaults to 0.0.0.0.
DASHBOARD_HOST=0.0.0.0
# Dashboard listening port; defaults to 7860.
DASHBOARD_PORT=7860
# Required dashboard authentication username.
DASHBOARD_USERNAME=replace-with-username
# Required dashboard authentication password.
DASHBOARD_PASSWORD=replace-with-password

# MT5 (executor only)
# Numeric MT5 account login.
MT5_LOGIN=replace-with-numeric-login
# MT5 trading account password.
MT5_PASSWORD=replace-with-password
# Broker server configured in the local terminal.
MT5_SERVER=replace-with-server
# Optional path to terminal64.exe.
MT5_TERMINAL_PATH=

# Watchdog (executor only)
# Required alert webhook URL, e.g. https://ntfy.sh/<topic>.
WATCHDOG_WEBHOOK_URL=https://ntfy.sh/replace-with-topic
# Optional dead-man's-switch ping URL.
HEALTHCHECK_PING_URL=
